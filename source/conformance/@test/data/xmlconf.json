              "ID": "rmt-ns11-001",
              "TYPE": "valid",
              "testPath": "./source/conformance/xmlts20130923/xmlconf/eduni/namespaces/1.1/001.xml",
              "testData": "<?xml version=\"1.1\" encoding=\"iso-8859-1\"?>\n<!-- Namespace name test: a perfectly good http IRI that is not a URI -->\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo xmlns CDATA #IMPLIED>\n]>\n<foo xmlns=\"http://example.org/rosé\"/>\n",
              "description": "Namespace name test: a perfectly good http IRI that is not a URI"
            },
            {
              "type": "TEST",
              "VERSION": "1.1",
