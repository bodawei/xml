              "TYPE": "invalid",
              "testPath": "./source/conformance/xmlts20130923/xmlconf/eduni/errata-3e/E06e.xml",
              "testData": "<!-- Default values for NMTOKEN attributes must match Nmtoken. -->\n<!DOCTYPE foo [\n<!ELEMENT foo EMPTY>\n<!ATTLIST foo a NMTOKEN \"34+\">\n]>\n<foo a=\"34\"/>\n",
