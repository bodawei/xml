              "E15i.xml": "<!DOCTYPE foo [\n<!ELEMENT foo (foo*)>\n]>\n<foo><foo/><!-- comment --><foo/></foo>\n",
              "E15j.xml": "<!DOCTYPE foo [\n<!ELEMENT foo (foo*)>\n]>\n<foo><foo/><?pi xxx?><foo/></foo>\n",
              "E15k.xml": "<!DOCTYPE foo [\n<!ELEMENT foo (PCDATA|foo)*>\n]>\n<foo><foo/><!-- comment --><foo/></foo>\n",
              "E15l.xml": "<!DOCTYPE foo [\n<!ELEMENT foo (PCDATA|foo)*>\n]>\n<foo><foo/><?pi xxx?><foo/></foo>\n",
              "E18-ent": "entity from main dir, right!",
              "E18.xml": "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ENTITY % pe SYSTEM \"subdir1/E18-pe\">\n%pe;\n%intpe;\n]>\n<foo>&ent;</foo>\n",
              "E19.dtd": "<!ELEMENT foo ANY>\n<!ENTITY % pe \"hello\">\n<!-- If forward were expanded when ent was declared, we were get an error,\n     but it is bypassed and not expanded until ent is used in the instance -->\n<!ENTITY ent \"%pe; &#33; &forward;\">\n<!ENTITY forward \"goodbye\">\n",
              "E19.xml": "<!DOCTYPE foo SYSTEM \"E19.dtd\">\n<foo>&ent;</foo>\n",
              "E20.xml": "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo bar NMTOKENS #IMPLIED>\n]>\n<foo bar=\"abc&#9;xyz\"/>\n",
              "E22.xml": "﻿<?xml version=\"1.0\"?>\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n]>\n<foo/>\n",
              "E24.xml": "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ENTITY gt \">\">\n]>\n<foo>You can use ]]&gt; or ]]&#62;</foo>\n",
              "E27.xml": "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n]>\n<foo>������</foo>\n",
              "E29.xml": "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo xml:lang NMTOKEN #IMPLIED>\n]>\n<foo xml:lang=\"nds\">\n <foo xml:lang=\"art-lojban\"/>\n</foo>\n",
              "E2a.xml": "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo bar (one|one) #IMPLIED>\n]>\n<foo/>\n\n",
              "E2b.xml": "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!NOTATION one SYSTEM \"file:///usr/bin/awk\">\n<!ATTLIST foo bar NOTATION (one|one) #IMPLIED>\n]>\n<foo/>\n",
              "E34.xml": "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ELEMENT bar (foo|foo)>\n]>\n<foo/>\n",
              "E36.dtd": "<!ELEMENT foo ANY>\n<!ATTLIST foo bar NMTOKENS #IMPLIED>\n",
              "E36.xml": "<?xml version=\"1.0\" standalone=\"yes\"?>\n<!DOCTYPE foo SYSTEM \"E36.dtd\">\n<foo bar=\"123\n456\"/>\n",
              "E38.ent": "<?xml version=\"1.1\" encoding=\"utf-8\"?>\n<foo/>\n",
              "E38.xml": "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ENTITY e SYSTEM \"E38.ent\">\n]>\n<foo>&e;</foo>\n",
              "E41.xml": "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo xml:lang CDATA #IMPLIED>\n]>\n<foo xml:lang=\"\"/>\n",
              "E48.xml": "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n]>\n<foo>hello</foo>\n",
              "E50.xml": "<?xml version=\"1.1\" encoding=\"iso-8859-1\"?>\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo bar CDATA #IMPLIED>\n]>\n<foo�bar=\"hello\"/>\n",
              "E55.xml": "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ENTITY e \"an &unparsed; entity\">\n<!NOTATION gif SYSTEM \"file:///usr/X11R6/bin/xv\">\n<!ENTITY unparsed SYSTEM \"xyzzy\" NDATA gif>\n]>\n<foo/>\n",
              "E57.xml": "<foo xml:space=\"discard-all-but-the-first-three-spaces\"/>\n",
