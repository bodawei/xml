              "testData": "<!-- Default values for ENTITIES attributes must match Names. -->\n<!DOCTYPE foo [\n<!ELEMENT foo EMPTY>\n<!ATTLIST foo a ENTITIES \"34\">\n<!ENTITY ent SYSTEM \"foo\" NDATA not>\n<!NOTATION not SYSTEM \"not\">\n]>\n<foo a=\"ent\"/>\n",
