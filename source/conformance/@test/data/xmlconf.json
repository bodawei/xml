�&markup;��������Τ����줫��������Ƥ���Ȥ��ϡ��� \"<code>no</code>\" ����ʤ���Фʤ�ʤ���\r\n<ulist>\r\n<item><p>a) <termref def=\"dt-default\">&default;</termref>���դ���°���Ǥ��äơ�����°����Ŭ�Ѥ�������Ǥ���°���ͤ���ꤻ����ʸ����˸�����Ρ�</p></item>\r\n<item><p>b) &magicents;�ʳ��μ��ΤǤ��äơ����μ��Τ��Ф���<termref def=\"dt-entref\">����</termref>��ʸ����˽и������Ρ�</p>\r\n</item>\r\n<item><p>c) �ͤ�<titleref href='AVNormalize'>������</titleref>���оݤȤʤ�°���Ǥ��äơ��������η�̤Ȥ����Ѳ������ͤ�ʸ�����°���˻��ꤵ����Ρ�</p></item>\r\n<item>\r\n<p>d) <termref def=\"dt-elemcontent\">��������</termref>�������Ƿ��Ǥ��äơ����򤬤������Ƿ��Τ����줫�Υ��󥹥������ľ�ܸ�����Ρ�\r\n</p></item>\r\n</ulist>\r\n</p>\r\n</vcnote>\r\n<p>&standalone;ʸ������դ���XML�������򡤼��˼�����\r\n<eg>&lt;?xml version=\"&XML.version;\" standalone='yes'?></eg></p>\r\n</div2>\r\n<div2 id='sec-white-space'>\r\n<head>����μ谷��</head>\r\n<p>XMLʸ����Խ�����Ȥ��ϡ�&markup;����Ω�����ɤߤ䤹�����뤿��ˡ��ȶ����(&space;�����ֵڤӶ���ԡ�����&TR-or-Rec;�Ǥϡ���ü�����<nt def='NT-S'>S</nt>��ɽ��)��Ȥ��������ʤ��Ȥ�¿�������ζ���ϡ����ۤ���&version;��ʸ��ΰ����Ȥ��ƴޤ�뤳�Ȥ�տޤ��ʤ��Τ����̤Ȥ��롣���������Ȱ�̣�Τ���ɶ���Ǥ��äơ����ۤ���&version;�˻Ĥ��ʤ���Фʤ�ʤ���Τ�¿�����㤨�С����ڤӥ����������ɤˤ�������򤬤��롣</p>\r\n<p><termref def='dt-xml-proc'>XML&processor;</termref>�ϡ�ʸ�����&markup;�ʳ��Τ��٤Ƥ�ʸ���򡤤��Τޤ��ѹ�������&application;���Ϥ��ʤ���Фʤ�ʤ���<termref def='dt-validating'>&validating;XML&processor;</termref>�ϡ�<termref def=\"dt-elemcontent\">��������</termref>����ζ����¾����&markup;ʸ��������̤���&application;¦���������Ƥ���ζ��򤬽��פǤʤ��Ȥ������Ȥ������ʤ���Фʤ�ʤ���</p>\r\n<p>\r\n\"<code>xml:space</code>\"�Ȥ������̤�<termref def='dt-attr'>°��</termref>��ʸ����������뤳�Ȥˤ�äơ��������פȤ���տޤ򼨤��Ƥ�褤������°����Ŭ�Ѥ������Ǥ˸�������򡤥��ץꥱ������󤬽��פʤ�ΤȤ��ư������Ȥ��׵᤹�롤�Ȥ����տޤ򼨤���</p>\r\n<p>&valid;��ʸ��Ǥϡ�����°������Ѥ�����ϡ�¾��°����Ʊ���褦��<termref def=\"dt-attdecl\">���</termref>���ʤ���Фʤ�ʤ����������Ȥ��ϡ���������ͤ�\"<code>default</code>\"�ڤ� \"<code>preserve</code>\"�����Ȥ���<termref def='dt-enumerated'>���</termref>�Ǥʤ���Фʤ�ʤ���\r\n</p>\r\n<p>��\"<code>default</code>\"�ϡ�&application;��&default;�ζ�������⡼�ɤ򡤤������Ǥ�Ŭ�Ѳ�ǽ�Ȥ��뤳�Ȥ��̣���롣��\"<code>preserve</code>\"�ϡ�&application;�����٤Ƥζ������¸���뤳�Ȥ��̣���롣��������ΰտޤϡ�\"<code>xml:space</code>\" °�����̤λ���Ǿ�񤭤��ʤ��¤ꡤ���Ǥ����Ƥ˸���뤹�٤Ƥ����Ǥ�Ŭ�Ѥ���Ȳ�᤹�롣</p>\r\n<p>ʸ���<termref def='dt-root'>&root;����</termref>�ˤĤ��Ƥϡ�����°�����ͤ���ꤹ�뤫�����Ϥ���°����&default-value;�������������Ƥϡ�&application;�ˤ�����μ谷���ˤĤ��ơ������ʤ�տޤ⼨���ʤ��Ȳ�᤹�롣</p>\r\n<p>��򼡤˼�����\r\n<eg><![CDATA[    <!ATTLIST poem   xml:space (default|preserve) 'preserve'>]]></eg>\r\n</p>\r\n</div2>\r\n<div2 id='sec-line-ends'>\r\n<head>�����μ谷��</head>\r\n<p>XML��<termref def='dt-parsedent'>��ʸ&parsed-entity;</termref>�ϡ��̾拾��ԥ塼���Υե����������¸���졤�Խ����ص��Τ����ʣ���ιԤ�ʬ���뤳�Ȥ�¿���������ιԤϡ����̤ϡ�<code>CR</code> (#xD)�����ɵڤ� <code>LF</code> (#xA)�����ɤβ��餫���ȹ礻�ˤ�ä�ʬ�����롣</p>\r\n<p><termref def='dt-app'>&application;</termref>�ν������ñ�ˤ��뤿�ᡤ����&parsed-entity;��������&parsed-entity;��&literal;�����ͤ���\"<code>#xD#xA</code>\" �Σ�ʸ����Ϣ³�Ȥ���&literal;����<code>#xD</code>��ñ�Ȥ�&literal;��ޤ���ˡ�<termref def='dt-xml-proc'>XML&processor;</termref>�ϡ�&application;��ñ���ʸ��<code>#xA</code>�������Ϥ��ʤ���Фʤ�ʤ�(���ν����ϡ��������¸�ߤ�����ԥ����ɤ�ʸ���Ϥ��������������뤳�Ȥˤ�äơ��ưפ˼¸��Ǥ��롣)��</p>\r\n</div2>\r\n<div2 id='sec-lang-tag'>\r\n<head>&language-identification;</head>\r\n<p>ʸ������ˤ����Ƥϡ�����ʸ�����Ȥ��ɤ�ʼ����������Ϸ�������ǽ񤫤�Ƥ��뤫�������뤳�Ȥ������Ω�Ĥ��Ȥ�¿����<!--�����ǻ��Ѥ���ȸ���ɤȤ������դΰ�̣�ϡ�\"Espa&#x00F1;ol\" �ڤ�\"EBNF\"���������㼨������̣�Ȥ��롣--><!-- x00F1: spanish's small ntilde--></p>\r\n<!--; ���ξ���ϡ���򤢤���С�ʸ���ʸ����ɽ�����¤Ӥ˾�����ФΤ���θ촴�������ǲ��ϵڤӥƥ����ȥ֥��å��������˱ƶ���ڤܤ���ǽ�������롣-->\r\n<p>XMLʸ��������ǤΤ����������°���ͤˤ����ƻ��Ѥ���<!--�������Ϸ���-->�������ꤹ�뤿��ˡ�\"<code>xml:lang</code>\" �Ȥ���̾�������̤�<termref def=\"dt-attr\">°��</termref>��ʸ������������Ƥ�褤��\r\n<!--; ����°����XML����ΰ����Ȥ��ơ�ʣ����XML&application;����߱���������뤿���������롣-->\r\n°�����ͤϡ�<bibref ref=\"RFC1766\"/>��RFC1766��&language-identification;�Τ���Υ����ɤˤ�äƵ��ꤵ���&language-identification;�����ɤ˽�����\r\n<scrap lang='ebnf'>\r\n<head>&language-identification;</head>\r\n<prod id='NT-LanguageID'><lhs>LanguageID</lhs>\r\n<rhs><nt def='NT-Langcode'>Langcode</nt> \r\n('-' <nt def='NT-Subcode'>Subcode</nt>)*</rhs></prod>\r\n<prod id='NT-Langcode'><lhs>Langcode</lhs>\r\n<rhs><nt def='NT-ISO639Code'>ISO639Code</nt> | \r\n<nt def='NT-IanaCode'>IanaCode</nt> | \r\n<nt def='NT-UserCode'>UserCode</nt></rhs>\r\n</prod>\r\n<prod id='NT-ISO639Code'><lhs>ISO639Code</lhs>\r\n<rhs>([a-z] | [A-Z]) ([a-z] | [A-Z])</rhs></prod>\r\n<prod id='NT-IanaCode'><lhs>IanaCode</lhs>\r\n<rhs>('i' | 'I') '-' ([a-z] | [A-Z])+</rhs></prod>\r\n<prod id='NT-UserCode'><lhs>UserCode</lhs>\r\n<rhs>('x' | 'X') '-' ([a-z] | [A-Z])+</rhs></prod>\r\n<prod id='NT-Subcode'><lhs>Subcode</lhs>\r\n<rhs>([a-z] | [A-Z])+</rhs></prod>\r\n</scrap>\r\n<nt def='NT-Langcode'>Langcode</nt>�ϡ����Τɤ�Ǥ�褤��\r\n<ulist>\r\n<item><p>a) <bibref ref=\"ISO639\"/>�ȸ����̾��ɽ���Τ���Υ����ɡɤǵ��ꤵ���2ʸ����&language-code;</p></item>\r\n<item><p>b) Internet Assigned Numbers Authority (IANA)����Ͽ����Ƥ���&language-code;������ϡ���Ƭ�� \"<code>i-</code>\" (����\"<code>I-</code>\")�ǻϤޤ롣</p></item>\r\n<item><p>c) &user;�ˤ�ä�����줿&language-code;�����ϻ�Ū�ʻ��ѤΤ����ʣ�������δ֤�����᤿�����ɡ������ϡ�����IANA�ˤ�����ɸ�ಽ������Ͽ����륳���ɤȤζ�����򤱤뤿��ˡ���Ƭ��\"<code>x-</code>\" ���� \"<code>X-</code>\" �ǻϤ�롣</p></item>\r\n</ulist></p>\r\n<p><nt def='NT-Subcode'>Subcode</nt>�ϡ�ʣ����ȤäƤ�褤���ǽ�Υ��֥����ɤ�¸�ߤ����������Ƥ���Ĥ�ʸ����������Ȥ��ϡ�<bibref ref=\"ISO3166\"/>ISO3166�Ρȹ�̾��ɽ��������(�񥳡���)�ɤǤʤ���Фʤ�ʤ����ǽ�Υ��֥����ɤ�3ʸ���ʾ夫������Ȥ��ϡ�<nt def='NT-Langcode'>Langcode</nt>����Ƭ����\"<code>x-</code>\" ���� \"<code>X-</code>\"�ǻϤޤ�ʤ��¤ꡤ���ꤷ��������Ф��륵�֥����ɤȤ���IANA����Ͽ���줿��ΤǤʤ���Фʤ�ʤ���</p>\r\n<p>&language-code;�ϡ���ʸ���Ǥ�ɽ����&country-code;�ϡ�(¸�ߤ���ʤ��)��ʸ���Ǥ�ɽ���򴷹ԤȤ��롣��������XMLʸ����ˤ�����¾��̾���Ȥϰۤʤꡤ�������ͤˤĤ��Ƥϡ���ʸ���ڤӾ�ʸ���ζ��̤򤷤ʤ����Ȥ����դ��뤳�ȡ�</p>\r\n<p>��򼡤˼�����\r\n<eg><![CDATA[<p xml:lang=\"en\">The quick brown fox jumps over the lazy dog.</p>\r\n<p xml:lang=\"en-GB\">What colour is it?</p>\r\n<p xml:lang=\"en-US\">What color is it?</p>\r\n<sp who=\"Faust\" desc='leise' xml:lang=\"de\">\r\n  <l>Habe nun, ach! Philosophie,</l>\r\n  <l>Juristerei, und Medizin</l>\r\n  <l>und leider auch Theologie</l>\r\n  <l>]]><!-- x00DF german's es-zet; x00FC german's u-umlaut -->durchaus studiert mit hei&#223;em Bem&#252;h'n.<![CDATA[</l>\r\n  </sp>]]></eg></p>\r\n<!--<p>xml:lang ���ͤϡ����Ǥ����Ƶڤ�(°����&default-value;�����ʤ��¤�)�ե꡼�ƥ�����(CDATA)���ͤ��Ĥ������ǤؤΤ��٤Ƥ�°�����ͤˤĤ��ơ�����ξ����Ŭ�Ѥ��롣-->\r\n<p><code>xml:lang</code>���������տޤϡ�<code>xml:lang</code>���̤λ���Ǿ�񤷤ʤ��¤ꡤ���ꤷ�����Ǥ����Ƥ˴ޤह�٤Ƥ����Ǥ�Ŭ�Ѥ��롣</p>\r\n<!--�������Ǥˤ����� xml:lang °�����ͤ������Ƥ��餺��DTD�ˤ����Ƥ���&default-value;�������Ƥ��ʤ���硤�������Ǥ�xml:lang °�����ͤϡ������ǤǤ��ͤ�¸�ߤ�����ϡ����������Ѥ��� ������ˤ�������Ĥ�<term>�Ȥ���̾���������Ѹ��ɽ�����Ǥϡ�xml:lang���ͤ˴ؤ��Ƥϡ��ºݾ塤Ʊ���ͤ��ġ�\r\n\r\n  <p xml:lang=\"en\">Here the keywords are\r\n  <term xml:lang=\"en\">shift</term> and\r\n  <term>reduce</term>. ...</p>\r\n\r\nXML&processor;�ǤϤʤ�&application;��������°���ͤηѾ��ˤĤ�����Ǥ���ġ�\r\n-->\r\n<p>\r\n&valid;��ʸ��ˤ����Ƥϡ�����&TR-or-Rec;��¾�ξ��ǵ��ꤹ��Ȥ��ꡤ����°����ɬ��������ʤ���Фʤ�ʤ����̾����ϡ����η��Ȥ��롣\r\n<eg>xml:lang  NMTOKEN  #IMPLIED</eg>\r\nɬ�פʤ�С������&default-value;��Ϳ���Ƥ�褤���Ѹ�����Ȥ�������ѤΥե�󥹸�λ����Ǥϡ������ڤ�����Ѹ�ǵ��Ҥ���С�xml:lang °���򼡤ΤȤ����������뤳�ȤȤʤ롣\r\n<eg><![CDATA[    <!ATTLIST poem   xml:lang NMTOKEN 'fr'>\r\n    <!ATTLIST gloss  xml:lang NMTOKEN 'en'>\r\n    <!ATTLIST note   xml:lang NMTOKEN 'en'>]]></eg>\r\n</p>\r\n<!--\r\nDTD���߷׼Ԥϡ�������ץȤ����(�ڤӤ���������)�����ݤ��ư����ΤǤϤʤ���������ץȵڤӸ����Ʊ�����ǰ����Τ�Ŭ���ʾ�硤����°����Ʊ�ͤ˥�����ץ�°����¸�ߤ����ͭ�Ѥ��Ȼפ����⤷��ʤ���������Ǥˤ����ơ����Ȥ��줿���ϥ�󥯤��줿�꥽�����ˤ�����(���פ�)����(���ˤ�äƤ�ʣ��)��ɽ�����Ǥ��������Τ�˾�ޤ�������������������&application;�ϡ�����&TR-or-Rec;�����ꤹ���ϰϳ��Ȥ��롣-->\r\n</div2>\r\n</div1>\r\n<!-- &Elements; -->\r\n\r\n<div1 id='sec-logical-struct'>\r\n<head>������¤</head>\r\n\r\n<p><termdef id=\"dt-element\" term=\"Element\">�����ʤ�<termref def=\"dt-xml-doc\">XMLʸ��</termref>�⡤��İʾ��<term>����</term>��ޤࡣ���Ǥζ�����, <termref def=\"dt-stag\">���ϥ���</termref>�ڤ�<termref def=\"dt-etag\">��λ����</termref>�ˤ�äƶ��ڤ롣���Ǥ�<termref def=\"dt-empty\">��</termref>���ǤΤȤ��ϡ�<termref def=\"dt-eetag\">�����ǥ���</termref>�Ǽ������ơ������Ǥϡ������ġ����Ƿ���̾��(����&identifier;(generic identifier)����GI�ȸƤ֤��Ȥ����롣)�ˤ�ä�&identified;�����Ǥϡ������Ĥ���°�����Ĥ��Ȥ��Ǥ��롣</termdef>°���ϡ�<termref def=\"dt-attrname\">̾��</termref>�ڤ�<termref def=\"dt-attrval\">��</termref>���ġ�</p>\r\n\r\n<scrap lang='ebnf'><head>����</head>\r\n<prod id='NT-element'><lhs>element</lhs>\r\n<rhs><nt def='NT-EmptyElemTag'>EmptyElemTag</nt></rhs>\r\n<rhs>| <nt def='NT-STag'>STag</nt> <nt def='NT-content'>content</nt> \r\n<nt def='NT-ETag'>ETag</nt></rhs><wfc def='GIMatch'/></prod>\r\n</scrap>\r\n<p>����&TR-or-Rec;�ϡ����Ƿ��ڤ�°���ΰ�̣��������ˡ������(��ʸ�˴ؤ��뤳�Ȥ����)̾���������Ϳ���ʤ�������������Ƭ��<code>(('X'|'x')('M'|'m')('L'|'l'))</code>��&match;����̾���ϡ����������Ϻ�����ǤΤ���&TR-or-Rec;�Ǥ�ɸ�ಽ�Τ����ͽ�󤹤롣</p>\r\n\r\n<wfcnote id='GIMatch'><head>���Ƿ���&match;</head>\r\n<p>���Ǥν�λ������<nt def='NT-Name'>̾��</nt>�ϡ��������Ǥγ��ϥ����ˤ����뷿��&match;���ʤ���Фʤ�ʤ���</p>\r\n</wfcnote>\r\n\r\n<div2 id='sec-starttags'>\r\n<head>���ϥ�������λ�����ڤӶ����ǥ���</head>\r\n<p><termdef id=\"dt-stag\" term=\"Start-Tag\">���Ǥʤ�Ǥ�դ�XML���ǤλϤޤ�ϡ�<term>���ϥ���</term>�ˤ�ä�&markup;���롣\r\n<scrap lang='ebnf'><head>���ϥ���</head>\r\n<prodgroup pcw2=\"6\" pcw4=\"15\" pcw5=\"11.5\">\r\n<prod id='NT-STag'><lhs>STag</lhs><rhs>'&lt;' <nt def='NT-Name'>Name</nt> (<nt def='NT-S'>S</nt> <nt def='NT-Attribute'>Attribute</nt>)* <nt def='NT-S'>S</nt>? '>'</rhs><wfc def=\"uniqattspec\"/></prod>\r\n<prod id='NT-Attribute'><lhs>Attribute</lhs><rhs><nt def='NT-Name'>Name</nt> <nt def='NT-Eq'>Eq</nt> <nt def='NT-AttValue'>AttValue</nt></rhs><vc def='ValueType'/><wfc def='NoExternalRefs'/><wfc def='CleanAttrVals'/></prod>\r\n</prodgroup>\r\n</scrap>\r\n���ϥ����ڤӽ�λ�������<nt def='NT-Name'>Name</nt>�ϡ����Ǥ�<term>��</term>��ɽ�魯��</termdef><termdef id=\"dt-attr\" term=\"Attribute\"><nt def='NT-Name'>Name</nt>�ڤ�<nt def='NT-AttValue'>AttValue</nt>���Ф����Ǥ�<term>°������</term>�Ȥ���</termdef>��<termdef id=\"dt-attrname\" term=\"Attribute Name\">�ġ����Фˤ�����<nt def='NT-Name'>Name</nt>�ϡ�<term>°��̾</term></termdef>�ڤ�<termdef id=\"dt-attrval\" term=\"Attribute Value\"><nt def='NT-AttValue'>AttValue</nt>������(���ڤ��<code>'</code>����<code>\"</code>�δ֤�&string;)��<term>°����</term>�Ȥ�����</termdef></p>\r\n\r\n<wfcnote id='uniqattspec'><head>°������ΰ����</head>\r\n<p>���ϥ������϶����ǥ����Ǥϡ�Ʊ���°��̾�����ٰʾ�и����ƤϤʤ�ʤ���</p></wfcnote>\r\n<vcnote id='ValueType'><head>°���ͤη�</head>\r\n<p>°�����������Ƥ��ʤ���Фʤ�ʤ���°���ͤη��ϡ�����°�����Ф�������������Ǥʤ���Фʤ�ʤ�(°���η��ˤĤ��Ƥϡ�<titleref href='AttDecls'>°���ꥹ�����</titleref>�ˤĤ��Ƥε���򻲾ȡ�)��</p></vcnote>\r\n<wfcnote id='NoExternalRefs'><head>�������Τؤλ��Ȥ��ʤ�����</head>\r\n<p>°���ͤˤϡ��������Τؤ�ľ��Ū���ϴ���Ū�ʻ��Ȥ�ޤळ�ȤϤǤ��ʤ���</p></wfcnote>\r\n<wfcnote id='CleanAttrVals'><head>°���ͤ�<code>&lt;</code>��ޤޤʤ�����</head>\r\n<p>°�������ľ��Ū���ϴ���Ū�˻��Ȥ������(<code>&amp;lt;</code>�������)��<termref def='dt-repltext'>&replacement-text;</termref>�ˤϡ�<code>&lt;</code>��ޤ�ǤϤʤ�ʤ���</p></wfcnote>\r\n\r\n<p>���ϥ�������򡤼��˼�����\r\n<eg>&lt;termdef id=\"dt-dog\" term=\"dog\"></eg></p>\r\n<p><termdef id=\"dt-etag\" term=\"End Tag\">���ϥ����ǻϤޤ����Ǥν����ϡ�<term>��λ����</term>��&markup;���ʤ���Фʤ�ʤ������ν�λ�����ϡ��б����볫�ϥ��������Ƿ���Ʊ��̾�����ġ�\r\n<scrap lang='ebnf'><head>��λ����</head><prodgroup pcw2=\"6\" pcw4=\"15\" pcw5=\"11.5\"><prod id='NT-ETag'><lhs>ETag</lhs><rhs>'&lt;/' <nt def='NT-Name'>Name</nt> <nt def='NT-S'>S</nt>? '>'</rhs></prod></prodgroup></scrap></termdef></p>\r\n<p>��λ��������򡤼��˼�����\r\n<eg>&lt;/termdef></eg></p>\r\n\r\n<p><termdef id=\"dt-content\" term=\"Content\">���Ǥγ��ϥ����Ƚ�λ�����Ȥδ֤�<termref def='dt-text'>�ƥ�����</termref>�򡤤������Ǥ�<term>����</term>�Ȥ�����\r\n<scrap lang='ebnf'><head>���Ǥ�����</head>\r\n<prodgroup pcw2=\"6\" pcw4=\"15\" pcw5=\"11.5\"><prod id='NT-content'><lhs>content</lhs><rhs>(<nt def='NT-element'>element</nt> | <nt def='NT-CharData'>CharData</nt> | <nt def='NT-Reference'>Reference</nt> | <nt def='NT-CDSect'>CDSect</nt> | <nt def='NT-PI'>PI</nt> | <nt def='NT-Comment'>Comment</nt>)*</rhs></prod></prodgroup></scrap></termdef></p>\r\n\r\n<p><termdef id=\"dt-empty\" term=\"Empty\">���Ǥ�<term>��</term>�ΤȤ����������Ǥϡ�ľ��˽�λ�������ĳ��ϥ������϶����ǥ�����ɽ�����ʤ���Фʤ�ʤ���</termdef><termdef id=\"dt-eetag\" term=\"empty-element tag\"><term>�����ǥ���</term>�ϡ��������̤ʷ�����Ȥ롣\r\n<scrap lang='ebnf'><head>�����ǤΤ���Υ���</head><prodgroup pcw2=\"6\" pcw4=\"15\" pcw5=\"11.5\"><prod id='NT-EmptyElemTag'><lhs>EmptyElemTag</lhs><rhs>'&lt;' <nt def='NT-Name'>Name</nt> (<nt def='NT-S'>S</nt> <nt def='NT-Attribute'>Attribute</nt>)* <nt def='NT-S'>S</nt>? '/&gt;'</rhs><wfc def=\"uniqattspec\"/></prod></prodgroup></scrap></termdef></p>\r\n\r\n<!-- ���ϡ���Ρȶ����ǤΤ���Υ���(tags for empty elements)�ɤϡȶ����ǥ���(empty-element tag)�ɤȤ��٤����Ȼפ��ޤ������������Ǥ��礦�� -->\r\n\r\n<p>�����ǥ����ϡ����Ƥ�⤿�ʤ�Ǥ�դ����Ǥ�ɽ�������ѤǤ��롣�����ǥ�����ɽ���������Ǥ򡤥������<kw>EMPTY</kw>���Ѥ���������ʤ��Ȥ�褤��</p>\r\n<p>�����Ǥ���򡤼��˼�����\r\n<eg>&lt;IMG align=\"left\" src=\"http://www.w3.org/Icons/WWW/w3c_home\" />&lt;br>&lt;/br>&lt;br/></eg></p>\r\n</div2>\r\n\r\n<div2 id='elemdecls'><head>�������</head>\r\n<p><termref def=\"dt-valid\">&validity;</termref>���ݾڤ��뤿�ᡤ��������ڤ�°���ꥹ��������Ѥ���<termref def=\"dt-xml-doc\">XMLʸ��</termref>��<termref def=\"dt-element\">����</termref>�ι�¤�ˡ������ä��뤳�Ȥ��Ǥ��롣</p>\r\n<p>��������ϡ����Ǥ�<termref def=\"dt-content\">����</termref>�ˤĤ��Ƥ�����Ȥ��롣</p>\r\n<p>��������ϡ����Ǥ�<termref def=\"dt-parentchild\">��</termref>�Ȥ��ƽи���ǽ�����Ƿ��ˤĤ��ơ������ä��뤳�Ȥ�¿����&at-user-option;�����������⤿�ʤ����Ƿ���¾����������ˤ�äƻ��Ȥ����С�XML&processor;�ϡ��ٹ��Ф��Ƥ�褤���������������&error;�ȤϤ��ʤ���</p>\r\n\r\n<p><termdef id=\"dt-eldecl\" term=\"Element Type declaration\"><term>���Ƿ����</term>�ϡ����η�����Ȥ롣\r\n<scrap lang='ebnf'><head>���Ƿ����</head><prodgroup pcw2=\"5.5\" pcw4=\"18\" pcw5=\"9\">\r\n<prod id='NT-elementdecl'><lhs>elementdecl</lhs>\r\n<rhs>'&lt;!ELEMENT' <nt def='NT-S'>S</nt> \r\n<nt def='NT-Name'>Name</nt> \r\n<nt def='NT-S'>S</nt> \r\n<nt def='NT-contentspec'>contentspec</nt>\r\n<nt def='NT-S'>S</nt>? '>'</rhs>\r\n<vc def='EDUnique'/></prod>\r\n<prod id='NT-contentspec'><lhs>contentspec</lhs>\r\n<rhs>'EMPTY' \r\n| 'ANY' \r\n| <nt def='NT-Mixed'>Mixed</nt> \r\n| <nt def='NT-children'>children</nt>\r\n</rhs>\r\n<vc def='elementvalid'/>\r\n</prod>\r\n</prodgroup>\r\n</scrap>\r\n�����ǡ�<nt def='NT-Name'>Name</nt>�ϡ��������Ƥ������Ǥη��Ȥ��롣</termdef></p>\r\n\r\n<vcnote id='EDUnique'><head>��������ΰ����</head>\r\n<p>���Ƿ����ٰʾ�����Ǥ��ʤ���</p></vcnote>\r\n\r\n<vcnote id='elementvalid'><head>���Ǥ�&validity;</head>\r\n<p>���Ǥ�<!-- said to be -->&valid;�Ȥϡ�<nt def='NT-elementdecl'>elementdecl</nt>��&match;��������Ǥ��äơ�����<nt def='NT-Name'>Name</nt>���������Ƿ���&match;�������Τ����줫�ξ������������Ȥ��롣<ulist>\r\n<item><p>a) �����<kw>EMPTY</kw>��&match;�������Ǥ�<termref def='dt-content'>����</termref>��⤿�ʤ���</p></item>\r\n<item><p>b) �����<nt def='NT-children'>children</nt>��&match;�������Ǥ�<termref def=\"dt-parentchild\">������</termref>���¤Ӥ������ƥ�ǥ������ɽ���ˤ�ä��������������°���롣</p></item>\r\n<item><p>c) �����<nt def='NT-Mixed'>mixed</nt>��&match;�������Ǥ����Ƥ�<termref def='dt-chardata'>ʸ���ǡ���</termref>�ڤ�<termref def='dt-parentchild'>������</termref>����ʤ롣�����Ǥ����Ƿ��ϡ����Ǥ����ƥ�ǥ�˽и�����̾����&match;���롣</p></item>\r\n<item><p>d) �����<kw>ANY</kw>��&match;�����ɤ�<termref def='dt-parentchild'>������</termref>�����Ƿ����������Ƥ��롣</p></item></ulist>\r\n\r\n</p></vcnote>\r\n<!-- with the new VC, I don't think the next few paras add anything -TWB\r\n<p><termdef id=\"dt-model\" term=\"content model\">An element can declared using a <term>content model</term>, in which case its content can be categorized as <termref def=\"dt-elemcontent\">element content</termref> or <termref def='dt-mixed'>mixed content</termref>, as explained below.</termdef></p>\r\n<p>An element whose type declared using the keyword <kw>EMPTY</kw> must be <termref def=\"dt-empty\">empty</termref> and may be tagged using an <termref def=\"dt-eetag\">empty-element tag</termref> when it appears in the document.</p>\r\n<p>If an element type is declared using the keyword <kw>ANY</kw>, then there are no validity constraints on its content:  it may contain <termref def='dt-parentchild'>child elements</termref> of any type and number, interspersed with character data.</p> -->\r\n\r\n<p>�����������򡤼��˼�����\r\n<eg>\r\n&lt;!ELEMENT br EMPTY>\r\n&lt;!ELEMENT p (#PCDATA|emph)* >\r\n&lt;!ELEMENT %name.para; %content.para; >\r\n&lt;!ELEMENT container ANY>\r\n</eg></p>\r\n\r\n<div3 id='sec-element-content'><head>��������</head>\r\n\r\n<p><termdef id='dt-elemcontent' term='Element content'>���뷿�����Ǥ�<termref def='dt-parentchild'>��</termref>���Ǥ�����ޤ�(ʸ���ǡ�����ޤޤʤ���)�Ȥ�����������<termref def=\"dt-stag\">��</termref>�ϡ�<term>��������</term>���ġ��Ȥ�����</termdef>���ξ�硤����ϡ����ƥ�ǥ��ޤࡣ���ƥ�ǥ�ϡ������Ǥη��ڤӻ����Ǥνи���������椹���ñ��ʸˡ�Ȥ��롣����ʸˡ�ϡ�&content-particle;(<nt def='NT-cp'>cp</nt>s)����ʤ롣&content-particle;�ϡ�̾����&content-particle;������ꥹ������&content-particle;����ꥹ�Ȥ��鹽������롣\r\n<scrap lang='ebnf'><head>�������ƥ�ǥ�</head><prodgroup pcw2=\"5.5\" pcw4=\"16\" pcw5=\"11\">\r\n<prod id='NT-children'><lhs>children</lhs><rhs>(<nt def='NT-choice'>choice</nt> | <nt def='NT-seq'>seq</nt>) ('?' | '*' | '+')?</rhs></prod><prod id='NT-cp'><lhs>cp</lhs><rhs>(<nt def='NT-Name'>Name</nt> | <nt def='NT-choice'>choice</nt> | <nt def='NT-seq'>seq</nt>) ('?' | '*' | '+')?</rhs></prod>\r\n<prod id='NT-choice'><lhs>choice</lhs><rhs>'(' <nt def='NT-S'>S</nt>? cp ( <nt def='NT-S'>S</nt>? '|' <nt def='NT-S'>S</nt>? <nt def='NT-cp'>cp</nt> )*<nt def='NT-S'>S</nt>? ')'</rhs><vc def='vc-PEinGr