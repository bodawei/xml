              "ID": "rmt-ns11-004",
              "TYPE": "valid",
              "testPath": "./source/conformance/xmlts20130923/xmlconf/eduni/namespaces/1.1/004.xml",
              "testData": "<?xml version=\"1.1\"?>\n<!DOCTYPE foo [\n<!ELEMENT foo (bar?)>\n<!ATTLIST foo xmlns:a CDATA #IMPLIED\n              a:attr CDATA #IMPLIED>\n<!ELEMENT bar (foo)>\n<!ATTLIST bar xmlns:a CDATA #IMPLIED>\n]>\n<!-- 1.1 style prefix unbinding and rebinding -->\n<foo xmlns:a=\"http://example.org/namespace\">\n <bar xmlns:a=\"\">\n  <foo xmlns:a=\"http://example.org/other-namespace\" a:attr=\"1\"/>\n </bar>\n</foo>\n",
              "description": "1.1 style prefix unbinding and rebinding"
