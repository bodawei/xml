const fs = require('fs');


function assembleValid(rootPath) {
   const sets = fs.readdirSync(rootPath);
   const results = {
      tests: {},
      resources: {}
   };

   sets.forEach(setName => {
      if (setName === '.DS_Store') {
         return;
      }

      results.tests[setName] = {};
      results.resources[setName] = {};

      const setPath = rootPath + '/' + setName;
      const testFiles = fs.readdirSync(setPath);

      testFiles.forEach(filename => {
         if (filename.indexOf('.xml') !== -1) {
            const input = fs.readFileSync(setPath + '/' + filename, { encoding: 'utf-8' });
            const outPath = setPath + '/out/' + filename;
            let output;

            if (fs.existsSync(outPath)) {
               output = fs.readFileSync(outPath, { encoding: 'utf-8' });
            }

            results.tests[setName][filename] = {
               input,
               output,
            };
         } else if (filename.indexOf('.ent') !== -1 || filename.indexOf('.dtd') !== -1) {
            results.resources[setName][filename] = fs.readFileSync(setPath + '/' + filename, { encoding: 'utf-8' });
         }
      });
   });

   return results;
}

function assembleAll() {
   const results10 = assembleValid('./xmlconf/ibm/not-wf');
   const results11 = assembleValid('./xmlconf/ibm/xml-1.1/not-wf');

   fs.writeFileSync('ibm-not-wf.ts', `const testData = ${JSON.stringify({
      ibm: results10,
   }, undefined, 4)}\nexport default testData;\n`);
   fs.writeFileSync('ibm-not-wf-11.ts', `const testData = ${JSON.stringify({
      ibm: results11,
   }, undefined, 4)}\nexport default testData;\n`);
}

assembleAll();
