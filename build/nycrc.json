{
   "include": [
      "source/*.ts",
      "source/**/*.ts",
      "build/*jasmine*.js",
      "source/*.js",
      "source/**/*.js"
   ],
   "require": [
      "babel-register"
   ],
   "reporter": [
      "lcov",
      "text-summary",
      "json-summary"
   ],
   "sourceMap": false,
   "instrument": false,
   "report-dir": "./temp/inside-build-nycrc/"
}