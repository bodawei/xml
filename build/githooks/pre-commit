#!/bin/bash

REPO_ROOT="`npm bin`/../../"
PRE_COMMIT_MSG_LOC="/tmp/git-repo-commit-temp.txt"
UPDATE_PACKAGE_SCRIPT="${REPO_ROOT}/build/githooks/update-package-version.js"

if [ "`git rev-parse --abbrev-ref HEAD`" != "master" ]; then
   exit 0
fi

echo "PREPARING TO COMMIT TO MASTER"
echo "----------------------------------------"
git diff
echo "----------------------------------------"

# https://stackoverflow.com/questions/3417896/how-do-i-prompt-the-user-from-within-a-commit-msg-hook
exec < /dev/tty

read -p "Bug: " bug
read -p "Kind [feat, fix, BREAKING CHANGE]: " KIND

if [ "$KIND" == "" -o "$KIND" == "feat" ]; then
   KIND="feature"
elif [ "$KIND" != "fix" -a "$KIND" != "BREAKING CHANGE" ]; then
   echo "Kind is not one of the required values: $KIND "
   exit -1
fi

cat << EOF > "${PRE_COMMIT_MSG_LOC}"
$bug

$KIND:
EOF

node "${UPDATE_PACKAGE_SCRIPT}" $KIND

git add package.json

exit 0;
