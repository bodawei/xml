{
    "compilerOptions": {
      "strict": true,
      "noImplicitAny": true,
      "allowJs": true,
      "pretty": true,
      "target": "es5",
      "sourceMap": true,
      "outDir": "./temp/typescript",

      "baseUrl": "./",
      "paths": {
        "error": [ "./source/error" ],
      }
     },
    "include": [
        "build/**/*jasmine*.js",
        "source/**/*.js",
        "source/**/*.ts"
    ],
    "exclude": [
        "node_modules",
    ],
}
