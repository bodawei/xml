{
   "compilerOptions": {
      "strict": true,
      "noImplicitAny": true,
      "allowJs": true,
      "pretty": true,
      "target": "es5",
      "sourceMap": true,
      "outDir": "./temp/typescript",
      "baseUrl": "./",
      "resolveJsonModule": true,
      "esModuleInterop": true,
      "paths": {
         "attFixer": [
            "source/AttFixer"
         ],
         "basic": [
            "./source/basic"
         ],
         "error": [
            "./source/error"
         ],
         "error-test": [
            "./source/error/@test/helper"
         ],
         "expand": [
            "./source/expand"
         ],
         "extractor": [
            "./source/extractor"
         ],
         "nodeStream": [
            "./source/nodeStream"
         ],
         "pToken": [
            "./source/pToken"
         ],
         "pToken-test": [
            "./source/pToken/@test/helper"
         ],
         "pTokenStream": [
            "./source/pTokenStream"
         ],
         "sToken": [
            "./source/sToken"
         ],
         "sToken-test": [
            "./source/sToken/@test/helper"
         ],
         "stringify": [
            "./source/stringify"
         ],
         "token": [
            "./source/token"
         ],
         "token-test": [
            "./source/token/@test/helper"
         ],
         "wellformedness": [
            "./source/wellformedness"
         ],
         "xToken": ["./source/xToken"],
         "xTokenStream": ["./source/xTokenStream"]
      }
   },
   "include": [
      "build/beforeJest.ts",
      "build/beforeJasmine.ts",
      "source/**/*.ts",
      "build/buildTestData.ts",
      "bcp47-validate.d.ts", // We don't really need this declared here. 
   ],
   "exclude": [
      "node_modules",
      "xmlconfig.json"
   ]
}