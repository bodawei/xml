{
   "compilerOptions": {
      "strict": true,
      "noImplicitAny": true,
      "allowJs": true,
      "pretty": true,
      "target": "es5",
      "sourceMap": true,
      "outDir": "./temp/typescript",
      "baseUrl": "./",
      "resolveJsonModule": true,
      "esModuleInterop": true,
      "paths": {
         "basic": [
            "./source/basic"
         ],
         "error": [
            "./source/error"
         ],
         "error-test": [
            "./source/error/@test/helper"
         ],
         "expand": [
            "./source/expand"
         ],
         "extractor": [
            "./source/extractor"
         ],
         "nodeStream": [
            "./source/nodeStream"
         ],
         "pTokenStream": [
            "./source/pTokenStream"
         ],
         "sToken": [
            "./source/sToken"
         ],
         "sToken-test": [
            "./source/sToken/@test/helper"
         ],
         "token": [
            "./source/token"
         ],
         "token-test": [
            "./source/token/@test/helper"
         ],
         "wellformedness": [
            "./source/wellformedness"
         ],
         "xToken": ["./source/xToken"],
         "xTokenStream": ["./source/xTokenStream"]
      }
   },
   "include": [
      "build/**/*jasmine*.js",
      "source/**/*.ts",
   ],
   "exclude": [
      "node_modules"
   ]
}