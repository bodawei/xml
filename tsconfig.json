{
    "compilerOptions": {
      "strict": true,
      "noImplicitAny": true,
      "allowJs": true,
      "pretty": true,
      "target": "es5",
      "sourceMap": true,
      "outDir": "./temp/typescript",

      "baseUrl": "./",
      "paths": {
         "basic": [ "./source/basic" ],
         "error": [ "./source/error" ],
         "sToken": [ "./source/sToken" ],
      }
     },
    "include": [
        "build/**/*jasmine*.js",
        "source/**/*.js",
        "source/**/*.ts"
    ],
    "exclude": [
        "node_modules",
    ],
}
