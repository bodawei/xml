{
    "compilerOptions": {
      "strict": true,
      "noImplicitAny": true,
      "allowJs": true,
      "pretty": true,
      "target": "es5",
      "sourceMap": true,
      "outDir": "./temp/typescript",

      "baseUrl": "./",
      "paths": {
         "basic": [ "./source/basic" ],
         "error": [ "./source/error" ],
         "error-test": [ "./source/error/@test/helper" ],
         "expand": [ "./source/expand" ],
         "extractor": [ "./source/extractor" ],
         "pTokenStream": [ "./source/pTokenStream" ],
         "sToken": [ "./source/sToken" ],
         "sToken-test": [ "./source/sToken/@test/helper" ],
         "token": [ "./source/token" ],
         "wellformedness": [ "./source/wellformedness" ],
         "xTokenStream": [ "./source/xTokenStream" ],
      }
     },
    "include": [
        "build/**/*jasmine*.js",
        "source/**/*.js",
        "source/**/*.ts"
    ],
    "exclude": [
        "node_modules",
    ],
}
