{
   "compilerOptions": {
      "strict": true,
      "skipLibCheck": true,
      "noImplicitAny": true,
      "allowJs": true,
      "pretty": true,
      "target": "es5",
      "sourceMap": true,
      "outDir": "./temp/typescript",
      "baseUrl": "./",
      "resolveJsonModule": true,
      "esModuleInterop": true,
      "downlevelIteration": true, 
      "paths": {
         "attFixer": [
            "source/attFixer"
         ],
         "basic": [
            "./source/basic"
         ],
         "basic-test": [
            "./source/basic/@test/helper"
         ],
         "expand": [
            "./source/expand"
         ],
         "flat": [
            "./source/flat"
         ],
         "node": [
            "source/node"
         ],
         "pToken": [
            "./source/pToken"
         ],
         "pTokenStream": [
            "./source/pTokenStream"
         ],
         "pToken-test": [
            "./source/pToken/@test/helper"
         ],
         "token": [
            "./source/token"
         ],
         "token-test": [
            "./source/token/@test/helper"
         ],
         "valid": [
            "./source/valid"
         ],
         "wellformedness": [
            "./source/wellformedness"
         ],
         "wellformedness-test": [
            "./source/wellformedness/@test/helper"
         ],
         "xToken": ["./source/xToken"],
         "xToken-test": ["./source/xToken/@test/helper"],
         "xTokenStream": ["./source/xTokenStream"]
      }
   },
   "include": [
      "build/beforeJest.ts",
      "source/**/*.ts",
      "build/buildTestData.ts",
      "bcp47-validate.d.ts", // We don't really need this declared here. 
   ],
   "exclude": [
      "node_modules",
      "source/basic/extractor/*New.ts", // Unfinished rewrite (ROADMAP P1); not type-correct yet.
      "xmlconfig.json"
   ]
}