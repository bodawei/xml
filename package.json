{
   "name": "xt4j",
   "version": "0.266.1",
   "description": "Build repository for the XT4J module",
   "copyright": "Copyright ® 2016-2017 by 柏大衛. All rights reserved.",
   "author": "柏大衛",
   "license": "UNLICENCED",
   "private": true,
   "scripts": {
      "build:locale": "node ./build/tool/doDerive.js",
      "build:xmlconf": "ts-node -r tsconfig-paths/register ./source/conformance/@test/build/buildTestData.ts ./source/conformance/xmlts20130923/xmlconf/ ./source/conformance/@test/data/xmlconf.json",
      "build:flat": "ts-node -r tsconfig-paths/register ./source/node/@test/build/buildFlatDocs.ts ./source/conformance/@test/data/xmlconf.json ./source/node/@test/data/flatDocs.json",
      "check": "prettier --write  'source/attFixer/**/*.ts' 'source/conformance/**/*.ts' 'source/expand/**/*.ts' 'source/pToken/**/*.ts' 'source/wellformedness/**/*.ts' 'source/stringify/**/*.ts' 'source/xToken/**/*.ts'",
      "check:types": "./node_modules/typescript/bin/tsc",
      "lint": "eslint --fix --config ./eslint.config.mjs source",
      "lint:all": "eslint --fix --config ./eslint.config.mjs source/basic source/valid",
      "lint:ci": "eslint --config ./eslint.config.mjs --max-warnings 0 source/valid source/token source/node source/demo",
      "jest:all": "jest --config ./jest.config.js --coverage",
      "test:jasmine": "ts-node -r tsconfig-paths/register ./node_modules/.bin/jasmine --config=./build/jasmine.json",
      "jest": "jest --config ./jest.config.js --watch --coverage",
      "test": "nodemon --ext ts --exec  './node_modules/.bin/ts-node -r tsconfig-paths/register ./node_modules/.bin/jasmine --config=./build/jasmine.json' "
   },
   "devDependencies": {
      "@babel/core": "7.29.13",
      "@babel/preset-env": "7.29.7",
      "@babel/preset-typescript": "7.29.7",
      "@jest/globals": "30.5.2",
      "@types/jasmine": "4.0.3",
      "@types/jest": "27.5.1",
      "@types/node": "26.6.6",
      "eslint": "10.14.0",
      "eslint-config-prettier": "10.1.8",
      "eslint-plugin-import-x": "4.17.1",
      "eslint-plugin-prettier": "5.5.7",
      "globals": "16.5.0",
      "jasmine": "4.1.0",
      "jasmine-core": "4.1.1",
      "jest": "30.5.2",
      "node-properties-parser": "0.0.2",
      "nodemon": "2.0.16",
      "prettier": "3.9.10",
      "ts-node": "10.9.2",
      "tsconfig-paths": "4.2.0",
      "typescript": "6.0.3",
      "typescript-eslint": "8.72.1"
   },
   "dependencies": {
      "bcp47-validate": "1.0.0",
      "eslint-plugin-custom-rules": "file:build/eslint/eslint-plugin-custom-rules",
      "iconv-lite": "0.7.3"
   }
}
