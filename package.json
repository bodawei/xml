   "scripts": {
      "check": "prettier --write  'source/expand/**/*.ts' 'source/pToken/**/*.ts' 'source/wellformedness/**/*.ts' 'source/stringify/**/*.ts' 'source/xToken/**/*.ts'",
      "lint": "eslint --fix --config ./.eslintrc.json source/**/*.ts",
      "jest:all": "jest --config ./jest.config.js --coverage",
      "jest": "jest --config ./jest.config.js --watch --coverage",
      "test": "nodemon --ext ts --exec  './node_modules/.bin/ts-node -r tsconfig-paths/register ./node_modules/.bin/jasmine --config=./build/jasmine.json' ",
      "build:xmlconf": "ts-node -r tsconfig-paths/register ./build/buildTestData.ts ./source/conformance/xmlts20130923/xmlconf/ ./source/conformance/@test/data/xmlconf.json",
      "old:build:watch": "babel --no-babelrc --config-file ./build/babelrc-new.json5 --extensions '.ts' --watch 'source/**/*.ts' --out-dir ./temp/build/",
      "old:test:cover": "xclap precommit",
      "old:tn": "ts-node -r tsconfig-paths/register"
   },
