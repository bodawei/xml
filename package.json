{
   "name": "xt4j",
   "version": "0.266.1",
   "description": "Build repository for the XT4J module",
   "copyright": "Copyright ® 2016-2017 by 柏大衛. All rights reserved.",
   "author": "柏大衛",
   "license": "UNLICENCED",
   "private": true,
   "scripts": {
      "build:locale": "node ./build/tool/doDerive.js",
      "build:xmlconf": "node --no-experimental-strip-types --import ./build/babelRegister.mjs -r tsconfig-paths/register ./build/runTs.cjs ./source/conformance/@test/build/buildTestData.ts ./source/conformance/xmlts20130923/xmlconf/ ./source/conformance/@test/data/xmlconf.json",
      "build:flat": "node --no-experimental-strip-types --import ./build/babelRegister.mjs -r tsconfig-paths/register ./build/runTs.cjs ./source/node/@test/build/buildFlatDocs.ts ./source/conformance/@test/data/xmlconf.json ./source/node/@test/data/flatDocs.json",
      "check": "oxfmt 'source/attFixer/**/*.ts' 'source/conformance/**/*.ts' 'source/expand/**/*.ts' 'source/pToken/**/*.ts' 'source/wellformedness/**/*.ts' 'source/stringify/**/*.ts' 'source/xToken/**/*.ts'",
      "check:types": "./node_modules/typescript/bin/tsc",
      "lint": "oxlint source",
      "lint:all": "oxlint source/basic source/valid",
      "lint:ci": "oxlint --max-warnings 0 source/valid source/token source/node source/demo",
      "lint:fix": "oxlint --fix source",
      "jest:all": "jest --config ./jest.config.js --coverage",
      "test:jasmine": "node --no-experimental-strip-types --import ./build/babelRegister.mjs -r tsconfig-paths/register ./node_modules/.bin/jasmine --config=./build/jasmine.json",
      "jest": "jest --config ./jest.config.js --watch --coverage",
      "test": "nodemon --ext ts --exec  'node --no-experimental-strip-types --import ./build/babelRegister.mjs -r tsconfig-paths/register ./node_modules/.bin/jasmine --config=./build/jasmine.json' "
   },
   "devDependencies": {
      "@babel/core": "8.1.0",
      "@babel/preset-env": "8.0.7",
      "@babel/preset-typescript": "8.0.7",
      "@babel/register": "8.0.6",
      "@jest/globals": "30.5.2",
      "@types/jasmine": "7.0.0",
      "@types/jest": "30.0.0",
      "@types/node": "26.6.6",
      "jasmine": "7.0.0",
      "jasmine-core": "7.0.2",
      "jest": "30.5.2",
      "nodemon": "3.1.14",
      "oxfmt": "^0.77.0",
      "oxlint": "^1.93.0",
      "oxlint-tsgolint": "^7.0.2006",
      "properties-parser": "0.6.0",
      "tsconfig-paths": "4.2.0",
      "typescript": "7.0.2"
   },
   "dependencies": {
      "bcp47-validate": "1.0.0"
   }
}
